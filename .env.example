# NewAPI 服务地址（必填）
NEWAPI_BASE_URL=http://127.0.0.1:3000

# 管理员 API Token（必填）
# 在 NewAPI 后台 → 令牌页面获取 role=100 的用户 Token
NEWAPI_TOKEN=sk-xxxxxxxxxxxxxxxx

# 监听端口（可选，默认 8898）
PORT=8898

# 每分组拉取日志条数（可选，默认 400）
# 越大覆盖的时间段越长，但响应也越慢
LOG_LIMIT=400

# 统计缓存秒数（可选，默认 120）
CACHE_TTL=120

# 排除的分组（可选，逗号分隔，这些分组不会显示也不会查询）
# EXCLUDE_GROUPS=test,debug
